<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/app_white"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/app_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtGoalTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mua Laptop"
            android:textColor="@color/app_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtGoalAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="5.000.000 / 30.000.000 VNĐ"
            android:textColor="@color/app_blue"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressGoal"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="14dp"
            android:max="100"
            android:progress="30"
            android:progressTint="@color/app_blue"
            android:progressBackgroundTint="#DCE8FA" />

        <TextView
            android:id="@+id/txtProgressPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="5dp"
            android:text="30%"
            android:textColor="@color/app_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#EDF2F8" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtGoalDeadline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hạn: 31/12/2026"
                android:textColor="@color/app_text_secondary"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btnEditGoal"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Sửa mục tiêu"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/app_blue_dark" />

            <ImageButton
                android:id="@+id/btnAddGoalAmount"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Thêm tiền vào mục tiêu"
                android:padding="12dp"
                android:src="@android:drawable/ic_input_add"
                app:tint="@color/app_green" />

            <ImageButton
                android:id="@+id/btnDeleteGoal"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Xóa mục tiêu"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="@color/app_red" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>