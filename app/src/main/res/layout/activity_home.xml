<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- Nội dung Home -->
    <ScrollView
        android:id="@+id/scrollHome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/cardBottomMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/app_blue"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="26dp"
                android:paddingEnd="22dp"
                android:paddingBottom="66dp">

                <TextView
                    android:id="@+id/txtTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BitMoney"
                    android:textColor="@color/app_white"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- Lời chào + Đăng xuất -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtWelcome"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Xin chào"
                        android:textColor="#DDEBFF"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/btnLogout"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="4dp"
                        android:text="Đăng xuất"
                        android:textColor="@color/app_white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Card số dư -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="-42dp"
                android:layout_marginEnd="18dp"
                app:cardBackgroundColor="@color/app_white"
                app:cardCornerRadius="24dp"
                app:cardElevation="7dp"
                app:strokeColor="@color/app_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SỐ DƯ HIỆN TẠI"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtBalance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="0 VNĐ"
                        android:textColor="@color/app_blue_dark"
                        android:textSize="29sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtBalanceDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Tiêu đề lịch sử -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="26dp"
                android:layout_marginEnd="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Giao dịch gần đây"
                    android:textColor="@color/app_text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtViewAllTransactions"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="4dp"
                    android:text="Xem tất cả ›"
                    android:textColor="@color/app_blue_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Tối đa 5 giao dịch -->
            <LinearLayout
                android:id="@+id/layoutRecentTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="18dp"
                android:orientation="vertical" />

            <!-- Khi chưa có giao dịch -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEmptyTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="18dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/app_white"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/app_border"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/txtEmptyTransactions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="26dp"
                    android:text="Chưa có giao dịch nào.\nNhấn nút + để thêm giao dịch đầu tiên."
                    android:textColor="@color/app_text_secondary"
                    android:textSize="15sp" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <!-- Thanh chức năng cố định -->
    <!-- Thanh chức năng cố định -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBottomMenu"
        android:layout_width="0dp"
        android:layout_height="86dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@color/app_white"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/app_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStatistics"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Thống kê"
                android:textAllCaps="false"
                android:textColor="@color/app_blue_dark"
                android:textSize="11sp"
                app:backgroundTint="@android:color/transparent"
                app:icon="@drawable/ic_statistics"
                app:iconGravity="textTop"
                app:iconPadding="6dp"
                app:iconSize="24dp"
                app:iconTint="@color/app_blue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDebt"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Khoản nợ"
                android:textAllCaps="false"
                android:textColor="@color/app_blue_dark"
                android:textSize="11sp"
                app:backgroundTint="@android:color/transparent"
                app:icon="@drawable/ic_debt"
                app:iconGravity="textTop"
                app:iconPadding="6dp"
                app:iconSize="24dp"
                app:iconTint="@color/app_blue" />

            <!-- Khoảng trống cho nút giao dịch -->
            <View
                android:layout_width="50dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBudget"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Ngân sách"
                android:textAllCaps="false"
                android:textColor="@color/app_blue_dark"
                android:textSize="11sp"
                app:backgroundTint="@android:color/transparent"
                app:icon="@drawable/ic_budget"
                app:iconGravity="textTop"
                app:iconPadding="6dp"
                app:iconSize="24dp"
                app:iconTint="@color/app_blue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCategory"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Danh mục"
                android:textAllCaps="false"
                android:textColor="@color/app_blue_dark"
                android:textSize="11sp"
                app:backgroundTint="@android:color/transparent"
                app:icon="@drawable/ic_category"
                app:iconGravity="textTop"
                app:iconPadding="6dp"
                app:iconSize="24dp"
                app:iconTint="@color/app_blue" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Nút giao dịch nổi chính giữa -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabTransaction"
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:contentDescription="Thêm giao dịch"
        android:elevation="20dp"
        android:translationY="38dp"
        android:translationZ="20dp"
        app:backgroundTint="@color/app_blue"
        app:borderWidth="5dp"
        app:elevation="20dp"
        app:fabCustomSize="76dp"
        app:layout_constraintBottom_toTopOf="@id/cardBottomMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:maxImageSize="32dp"
        app:pressedTranslationZ="24dp"
        app:rippleColor="@color/app_blue_light"
        app:srcCompat="@drawable/ic_add"
        app:tint="@color/app_white"
        app:useCompatPadding="true" />

</androidx.constraintlayout.widget.ConstraintLayout>